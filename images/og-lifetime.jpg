<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0b0f14"></stop>
      <stop offset="1" stop-color="#172233"></stop>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"></rect>
  <text x="60" y="300" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="78" fill="#ffffff">
    Lifetime Customers
  </text>
  <text x="60" y="375" font-family="Inter, Arial, sans-serif" font-size="36" fill="#cfe0f2">
    New customers. No ad spend.
  </text>
</svg>
