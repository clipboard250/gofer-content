<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dayna Himot — Resume</title>

  <style>
    :root{
      --ink:#111827;
      --muted:#4b5563;
      --rule:#1f3b66;       /* deep blue line */
      --accent:#1f3b66;     /* header text */
      --paper:#ffffff;

      --serif: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
      --sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, "Noto Sans", "Liberation Sans", sans-serif;

      --page-width: 860px;
    }

    /* Page */
    html, body { height: 100%; }
    body{
      margin:0;
      background:#f3f4f6;
      color:var(--ink);
      font-family:var(--sans);
      line-height:1.45;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
    }

    .page{
      max-width: var(--page-width);
      margin: 28px auto;
      background: var(--paper);
      box-shadow: 0 10px 30px rgba(0,0,0,.08);
      border-radius: 14px;
      padding: 42px 48px;
    }

    /* Header */
    .name{
      font-family: var(--serif);
      font-weight: 700;
      letter-spacing: .2px;
      color: var(--accent);
      font-size: 54px;
      line-height: 1.05;
      margin: 0 0 10px 0;
    }

    .contact{
      display:flex;
      flex-wrap:wrap;
      gap: 10px 22px;
      color: var(--muted);
      font-size: 16px;
      margin-bottom: 14px;
    }

    .rule{
      height: 3px;
      background: var(--rule);
      border-radius: 999px;
      margin: 8px 0 22px 0;
    }

    /* Sections */
    .section{
      margin-top: 18px;
    }

    .section-title{
      font-weight: 800;
      letter-spacing: .16em;
      color: var(--accent);
      font-size: 14px;
      text-transform: uppercase;
      margin: 0;
    }

    .section-rule{
      height: 1px;
      background: rgba(31,59,102,.22);
      margin: 10px 0 14px 0;
    }

    .para{
      margin: 0 0 10px 0;
      font-size: 16px;
      color: var(--ink);
    }

    .strengths{
      font-size: 16px;
      color: var(--ink);
      margin: 0;
    }

    /* Experience blocks */
    .job{
      margin: 0 0 18px 0;
    }

    .job-head{
      display:flex;
      justify-content:space-between;
      gap: 18px;
      align-items:baseline;
      flex-wrap:wrap;
      margin-bottom: 4px;
    }

    .job-title{
      font-weight: 800;
      color: var(--ink);
      font-size: 20px;
      margin: 0;
    }

    .job-meta{
      color: var(--muted);
      font-size: 16px;
      margin: 0 0 10px 0;
    }

    ul.bullets{
      margin: 0;
      padding-left: 18px;
      color: var(--ink);
      font-size: 16px;
    }

    ul.bullets li{
      margin: 6px 0;
    }

    /* Two-column sections at bottom */
    .grid-2{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 26px;
    }

    @media (max-width: 820px){
      .page{ padding: 28px 22px; border-radius: 0; margin: 0; }
      .name{ font-size: 42px; }
      .grid-2{ grid-template-columns: 1fr; }
    }

    /* Print */
    @page{
      size: Letter;
      margin: 0.6in;
    }

    @media print{
      body{ background:#fff; }
      .page{
        box-shadow:none;
        border-radius:0;
        margin:0;
        padding:0;
        max-width:none;
      }
      a{ color: inherit; text-decoration:none; }
    }
  </style>
</head>

<body>
  <main class="page" role="document" aria-label="Resume">
    <header>
      <h1 class="name">Dayna Himot</h1>

      <div class="contact" aria-label="Contact information">
        <span>St. Petersburg, FL</span>
        <span>727-353-9673</span>
        <span>daynahimot@gmail.com</span>
        <span>linkedin.com/in/daynahimot</span>
      </div>

      <div class="rule" aria-hidden="true"></div>
    </header>

    <section class="section" aria-labelledby="summary">
      <h2 class="section-title" id="summary">Summary</h2>
      <div class="section-rule" aria-hidden="true"></div>
      <p class="para">
        Customer-focused hospitality professional with proven track record coordinating high-volume events, managing logistics under pressure, and delivering exceptional guest experiences. Combines sharp organizational skills with hands-on service expertise from event production, volunteer coordination, and food service roles.
      </p>
    </section>

    <section class="section" aria-labelledby="strengths">
      <h2 class="section-title" id="strengths">Strengths</h2>
      <div class="section-rule" aria-hidden="true"></div>
      <p class="strengths">
        Guest Relations | Event Coordination | Team Communication | High-Pressure Performance | Detail Management | Service Excellence | Setup &amp; Logistics | Flexible Scheduling
      </p>
    </section>

    <section class="section" aria-labelledby="experience">
      <h2 class="section-title" id="experience">Experience</h2>
      <div class="section-rule" aria-hidden="true"></div>

      <article class="job">
        <div class="job-head">
          <h3 class="job-title">DPW Man Pavilion Shop Steward | Burning Man Project</h3>
        </div>
        <p class="job-meta">Gerlach, NV | July 2023 - Nov 2025</p>
        <ul class="bullets">
          <li>Managed equipment logistics and setup for 70,000+ person event, coordinating multiple trailers and ensuring crew had functional tools and resources throughout high-demand operations</li>
          <li>Created clear signage and communication systems to keep teams informed and efficient in fast-paced, physically demanding environment</li>
